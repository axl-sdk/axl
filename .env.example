# Axl environment variables — copy to `.env` (gitignored) and fill in what you need.
#
# Almost everything is OPTIONAL: set only the keys for the providers you use. The
# integration test suite (`pnpm test:integration`) auto-skips any provider whose
# key is absent, so a partial `.env` is fine.
#
# ── Core providers (native adapters) ───────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
# Either var works; GEMINI_API_KEY is the documented fallback.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# ── OpenAI-compatible presets (Tier 1) ─────────────────────────────────────
# OpenRouter — 300+ models behind one key — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# xAI (Grok) — https://console.x.ai  (Team → API Keys)
XAI_API_KEY=
# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Groq (fastest inference; open-weight models) — https://console.groq.com/keys
GROQ_API_KEY=

# ── Azure OpenAI ───────────────────────────────────────────────────────────
# Portal → your Azure OpenAI resource → "Keys and Endpoint" (need resource access:
# https://aka.ms/oai/access). The base URL is resource-specific and the "model" is
# your DEPLOYMENT name. All three are required for the azure: preset + its tests.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=          # e.g. https://my-resource.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=        # e.g. gpt-4o (your deployment's name)

# ── Self-hosted / local (no key) ───────────────────────────────────────────
# Install + run a server (e.g. Ollama: https://ollama.com, then `ollama serve`).
# Set OLLAMA_BASE_URL to opt the local integration test in; OLLAMA_MODEL picks the
# model to smoke-test. Same pattern for vllm/lmstudio/llamacpp/sglang (<NAME>_BASE_URL).
OLLAMA_BASE_URL=                # e.g. http://localhost:11434/v1
OLLAMA_MODEL=                   # e.g. llama3
# VLLM_API_KEY=                 # only if your vLLM server enforces one

# ── AWS Bedrock (gpt-oss via the OpenAI-compatible endpoint) ────────────────
# Bearer API key — AWS console → Bedrock → "API keys" — https://docs.aws.amazon.com/bedrock/
# Base URL is region-specific (prefer the bedrock-mantle endpoint). Model ids carry a
# version suffix, e.g. bedrock:openai.gpt-oss-120b
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_BASE_URL=              # e.g. https://bedrock-mantle.us-east-1.api.aws/v1
# BEDROCK_MODEL=                 # e.g. openai.gpt-oss-20b  (mantle endpoint; runtime uses the -1:0 suffix)

# ── Optional base-URL overrides (proxies/gateways) ─────────────────────────
# OPENAI_BASE_URL=
# OPENROUTER_BASE_URL=  XAI_BASE_URL=  DEEPSEEK_BASE_URL=  MISTRAL_BASE_URL=  GROQ_BASE_URL=

# ── Runtime config (optional) ──────────────────────────────────────────────
# AXL_DEFAULT_PROVIDER=openai
# REDIS_URL=redis://localhost:6379     # for RedisStore in multi-process deployments
# AXL_TRACE_ENABLED=true  AXL_TRACE_LEVEL=steps
